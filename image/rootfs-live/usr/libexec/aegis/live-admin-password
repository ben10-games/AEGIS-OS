#!/usr/bin/env bash
# AEGIS OS Live ISO only: development administrator access for this boot.
#
# The live desktop account is unprivileged. At every boot this sets a new random
# password for root and shows it only on the text consoles (agetty's issue text, a
# root-only file). It is not on the ISO, it is never in the desktop account's reach,
# and it is gone at power-off (the live system's changes live in memory). Whoever
# controls the virtual machine's console can read it, which is no more than they already
# control: the live boot menu has no password either. SSH refuses passwords (dev variant).
set -euo pipefail

alphabet='abcdefghjkmnpqrstuvwxyz23456789'
random="$(head -c 4096 /dev/urandom | LC_ALL=C tr -dc "${alphabet}")"
if [[ "${#random}" -lt 16 ]]; then
  echo "error: not enough random characters" >&2
  exit 1
fi
password="${random:0:4}-${random:4:4}-${random:8:4}-${random:12:4}"
printf 'root:%s\n' "${password}" | chpasswd

umask 077
issue=/etc/issue.d/50-aegis-live-admin.issue
install -d -m 0755 /etc/issue.d
cat > "${issue}.tmp" << TEXT

  AEGIS OS Live (development): administrator access for this boot only
    user: root    password: ${password}
  In the desktop terminal (Konsole), run: su -
  The password is not stored on the ISO and changes at every boot.

TEXT
chmod 0600 "${issue}.tmp"
mv "${issue}.tmp" "${issue}"
echo "AEGIS live: a new administrator password for this boot is shown on the text consoles"
