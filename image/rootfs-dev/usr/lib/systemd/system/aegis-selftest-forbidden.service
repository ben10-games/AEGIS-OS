# Development variant only; started by tests/vm/test_selinux.py, never enabled.
# The program is a copy of 'cat' labelled aegis_selftest_exec_t, so systemd starts it
# in the confined domain aegis_selftest_t.
[Unit]
Description=AEGIS SELinux self-test: read the forbidden file

[Service]
Type=oneshot
ExecStart=/usr/libexec/aegis/selftest/cat /usr/share/aegis/selftest/forbidden
StandardOutput=null
StandardError=null
