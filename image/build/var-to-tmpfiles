#!/usr/bin/env bash
# Runs inside an image build (image/Containerfile.gui). Makes the content that a
# package installation left in /var, /run and /tmp acceptable to bootc:
#
#   var-to-tmpfiles snapshot          record what exists now
#   var-to-tmpfiles finish NAME       compare with the snapshot:
#     - new directories under /var become 'd' lines in /usr/lib/tmpfiles.d/NAME.conf
#       (same mode and owner), so systemd creates them on the installed system;
#     - new files under /var (caches, checksums) and new content in /run and /tmp
#       are removed: they are runtime state and would be stale in an image.
#
# Nothing that existed before the snapshot is touched.
set -euo pipefail

state=/usr/libexec/aegis-build/var.snapshot
roots=(/var /run /tmp)

case "${1:-}" in
  snapshot)
    find "${roots[@]}" -xdev -mindepth 1 | LC_ALL=C sort > "${state}"
    ;;
  finish)
    name="${2:?name of the tmpfiles.d file}"
    find "${roots[@]}" -xdev -mindepth 1 | LC_ALL=C sort > "${state}.after"
    mapfile -t new < <(LC_ALL=C comm -13 "${state}" "${state}.after")
    rm -f "${state}" "${state}.after"
    conf="/usr/lib/tmpfiles.d/${name}.conf"
    lines=()
    for path in "${new[@]}"; do
      [[ -e "${path}" || -L "${path}" ]] || continue
      case "${path}" in
        /var/*)
          if [[ -d "${path}" && ! -L "${path}" ]]; then
            lines+=("$(stat -c 'd %n %a %U %G - -' "${path}")")
          elif [[ ! -L "${path}" ]]; then
            echo "removing runtime file left in the image: ${path}"
            rm -f "${path}"
          fi
          ;;
        *)
          echo "removing runtime content left in the image: ${path}"
          rm -rf "${path}"
          ;;
      esac
    done
    # Directories that became empty after removing their files are still created.
    if [[ "${#lines[@]}" -gt 0 ]]; then
      {
        echo "# Directories under /var created by packages of this image (generated by"
        echo "# image/build/var-to-tmpfiles during the image build)."
        printf '%s\n' "${lines[@]}"
      } > "${conf}"
      echo "wrote ${conf} (${#lines[@]} directories)"
    fi
    ;;
  *)
    echo "usage: var-to-tmpfiles snapshot | finish NAME" >&2
    exit 2
    ;;
esac
