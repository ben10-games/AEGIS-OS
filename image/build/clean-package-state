#!/usr/bin/env bash
# Runs inside the image build, right after any dnf operation. Removes what package
# operations leave in /var and /run. In a bootc image /usr is the system; files in
# /var are only copied once at install time and never updated, and /run must be empty.
# 'bootc container lint' rejects these leftovers.
set -euo pipefail

dnf clean all
rm -rf \
  /etc/.pwd.lock \
  /run/dnf \
  /var/cache/ldconfig/aux-cache \
  /var/cache/libdnf5 \
  /var/lib/dnf \
  /var/log/dnf5.log* \
  /usr/lib/sysimage/libdnf5/transaction_history.sqlite-shm \
  /usr/lib/sysimage/libdnf5/transaction_history.sqlite-wal
# The two SQLite side files above hold dnf's record of the build's own transactions,
# with the wall-clock time of the build; they made otherwise identical builds differ
# (R-02, run 44731480599). The package database (rpmdb) and the RPM lock remain the
# record of what is installed; dnf's history of an image build has no use on a bootc
# system, whose packages change only by replacing the image.
