# AEGIS OS base image (release-shaped). Milestone M1: the pinned Fedora bootc base plus
# identity metadata only. Hardening and the sealed boot chain arrive in later tasks.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG AEGIS_VERSION=0.1.0-dev
ARG AEGIS_REVISION=unknown

# Vendor data lives under /usr/lib; the image writes nothing of its own to /etc.
RUN install -d -m 0755 /usr/lib/aegis \
    && printf 'AEGIS_VARIANT=base\nAEGIS_VERSION=%s\nAEGIS_REVISION=%s\n' \
       "${AEGIS_VERSION}" "${AEGIS_REVISION}" > /usr/lib/aegis/release \
    && chmod 0644 /usr/lib/aegis/release

LABEL org.opencontainers.image.title="AEGIS OS (base)" \
      org.opencontainers.image.source="https://github.com/ben10-games/AEGIS-OS" \
      org.opencontainers.image.version="${AEGIS_VERSION}" \
      org.opencontainers.image.revision="${AEGIS_REVISION}"

# B-01: the image must satisfy bootc's own structural checks.
RUN bootc container lint --fatal-warnings
