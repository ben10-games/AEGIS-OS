# Seals an AEGIS OS root filesystem (ADR-0004):
#
#   1. take the kernel and initramfs out of the root filesystem (stage 'split'),
#   2. build a Unified Kernel Image whose command line carries the composefs digest of
#      that root filesystem, signed for Secure Boot (stage 'sealed-uki'),
#   3. add the UKI under /boot, which is not part of the digest.
#
# The digest is computed by scripts/build-image from the 'split' image in container
# storage, exactly as 'bootc install' computes it, and passed in as build arguments.
# (bootc's own 'container ukify' reads a mounted filesystem instead; with our layered
# build that view differs in directory metadata and the image would not install:
# CI runs 44074603737 and 44076988380.) After the build, scripts/build-image checks
# that the finished image still has the sealed digest.
ARG ROOTFS
ARG TOOLS=localhost/aegis-builder:latest

# The kernel and initramfs, for the UKI build only.
FROM ${ROOTFS} AS kernel
RUN mkdir /kernel && bootc container split-kernel-and-rootfs --rootfs / --output /kernel

# The root filesystem without them. This stage becomes the image.
FROM ${ROOTFS} AS split
RUN mkdir -p /var/tmp/aegis-split \
    && bootc container split-kernel-and-rootfs --rootfs / --output /var/tmp/aegis-split \
    && rm -rf /var/tmp/aegis-split

# The signing key is a build secret: mounted for this command, never stored in a layer.
FROM ${TOOLS} AS sealed-uki
ARG COMPOSEFS_DIGEST_V1
ARG COMPOSEFS_DIGEST_V2
COPY image/build/seal-uki /usr/local/bin/seal-uki
RUN --mount=type=bind,from=split,target=/target \
    --mount=type=bind,from=kernel,source=/kernel,target=/kernel \
    --mount=type=secret,id=secureboot_key \
    --mount=type=secret,id=secureboot_cert \
    COMPOSEFS_DIGEST_V1="${COMPOSEFS_DIGEST_V1}" COMPOSEFS_DIGEST_V2="${COMPOSEFS_DIGEST_V2}" \
    /usr/local/bin/seal-uki

FROM split
COPY --from=sealed-uki /out/uki/ /boot/EFI/Linux/
