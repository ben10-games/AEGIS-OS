# AEGIS OS (GUI v1): system-wide KWin defaults. Users can change all of these in System
# Settings; their own ~/.config/kwinrc takes precedence. KConfig reads system defaults
# only from XDG configuration directories, hence /etc/xdg.

# Glass: KWin's own blur effect draws the backdrop behind translucent panels, popups
# and windows that ask for it. Moderate strength: each blur pass costs GPU time, and in
# a virtual machine without 3D it runs in software (llvmpipe). Values mirror
# org.aegisos.style Tokens.blur. (This KWin build loads no separate 'contrast' or
# 'slidingpopups' effect, run 44749833133, so they are not configured here.)
[Plugins]
blurEnabled=true

[Effect-blur]
BlurStrength=12
NoiseStrength=2

# The on-screen keyboard (plasma-keyboard) used about 266 MB and is not needed with a
# physical or virtual keyboard. It stays installed and can be switched on in
# System Settings > Keyboard > Virtual Keyboard.
[Wayland]
InputMethod[$e]=
VirtualKeyboardEnabled=false

# Alt+Tab shows window thumbnails in a grid (v3, M10). The look-and-feel package cannot
# set this: Plasma applies only some of its defaults (v3 run 46027289849).
[TabBox]
LayoutName=thumbnail_grid
