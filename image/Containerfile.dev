# AEGIS OS development variant: the base root filesystem plus SSH so automated tests can
# reach the VM. Never a release artifact. No login key is baked in; the test harness
# injects one when the virtual machine starts. Like the base, this builds an UNSEALED
# root filesystem that image/Containerfile.seal seals. Built from the repository root.
ARG BASE=localhost/aegis-base-rootfs:latest

# Stage 1: compile the self-test SELinux module against exactly the policy version in
# the base image. The compiler and its dependencies stay in this stage.
FROM ${BASE} AS policy
ARG SOURCE_DATE_EPOCH
COPY image/build/install-locked /usr/local/bin/install-locked
RUN --mount=type=bind,from=rpms,source=dev-policy,target=/tmp/aegis-rpms \
    install-locked /tmp/aegis-rpms \
    && rpm -q "selinux-policy-devel-$(rpm -q --qf '%{VERSION}-%{RELEASE}' selinux-policy)"
COPY policy/selinux/aegis_selftest.te policy/selinux/aegis_selftest.fc /policy/
RUN make -C /policy -f /usr/share/selinux/devel/Makefile aegis_selftest.pp

# Stage 2: the image.
FROM ${BASE}

ARG AEGIS_VERSION=0.1.0-dev
ARG AEGIS_REVISION=unknown
ARG SOURCE_DATE_EPOCH

COPY image/build/ /usr/libexec/aegis-build/

# Locked inputs only, as in image/Containerfile.
RUN --mount=type=bind,from=rpms,source=dev,target=/tmp/aegis-rpms \
    /usr/libexec/aegis-build/install-locked /tmp/aegis-rpms \
    && /usr/libexec/aegis-build/clean-package-state

COPY image/rootfs-dev/ /

# The self-test policy module (development only); installed by configure-image.
COPY --from=policy /policy/aegis_selftest.pp /usr/share/selinux/packages/aegis/aegis_selftest.pp

RUN AEGIS_VARIANT=dev AEGIS_VERSION="${AEGIS_VERSION}" AEGIS_REVISION="${AEGIS_REVISION}" \
      /usr/libexec/aegis-build/configure-image \
    && rm -rf /usr/libexec/aegis-build

LABEL org.opencontainers.image.title="AEGIS OS (dev)"

RUN bootc container lint --fatal-warnings
