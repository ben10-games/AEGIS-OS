# AEGIS OS graphical development image (M4-GUI): the development root filesystem plus
# KDE Plasma 6 on Wayland (KWin), Qt 6 / QML and Kirigami, and the first AEGIS visual
# identity. Like every variant it is sealed afterwards (image/Containerfile.seal) and
# boots with Secure Boot. Never a release artifact. See docs/architecture/gui-architecture.md.
ARG BASE=localhost/aegis-dev-rootfs:latest
FROM ${BASE}

ARG SOURCE_DATE_EPOCH

COPY image/build/ /usr/libexec/aegis-build/

# Flatpak (moved here from the Live ISO in v3, so installed disks have it): Fedora's
# fedora-flathub-remote supplies Flathub's remote definition (URL and signing key) in a
# Fedora-signed RPM. It is kept as a file for the per-user remote
# (aegis-flathub-user-remote, a user unit) and removed from remotes.d, and the unit that
# adds Fedora's own system remote at boot is masked: there is no system-wide remote, so
# applications are installed with --user into the user's home, without administrator
# rights (CI runs 45403902691, 45407725319). The 'fedora' remote that the package writes
# into /var at install time is removed with the rest of /var by var-to-tmpfiles.
# VirtualBox guest tools (moved here in v3): their units start only inside VirtualBox.
#
# Plasma 6 without weak dependencies: the shell and compositor, the login manager, the
# core applications (terminal, file manager, settings), network and audio integration,
# portals, Qt Quick / Kirigami, and software rendering for virtual machines.
# Fedora 45's KDE edition uses plasma-login-manager; AEGIS uses SDDM for now, whose
# configuration is documented and stable (decision in gui-architecture.md).
# Locked inputs only (P1-15): the 'gui' step of image/packages/rpms.in.yaml, verified by
# scripts/fetch-inputs, installed without network and with every repository disabled.
RUN --mount=type=bind,from=rpms,source=gui,target=/tmp/aegis-rpms \
    /usr/libexec/aegis-build/var-to-tmpfiles snapshot \
    && /usr/libexec/aegis-build/install-locked /tmp/aegis-rpms \
    && repo="$(rpm -ql fedora-flathub-remote | grep '\.flatpakrepo$' | head -n 1)" \
    && test -n "${repo}" \
    && grep -q '^Url=https://dl.flathub.org/repo/$' "${repo}" \
    && grep -q '^GPGKey=.' "${repo}" \
    && install -D -m 0644 "${repo}" /usr/share/aegis/flatpak/flathub.flatpakrepo \
    && sed -i '/^Filter=/d' /usr/share/aegis/flatpak/flathub.flatpakrepo \
    && rm -fv /usr/share/flatpak/remotes.d/*.flatpakrepo /etc/flatpak/remotes.d/*.flatpakrepo \
    && for unit in $(systemctl list-unit-files 'flatpak-add-*' --no-legend | awk '{print $1}'); do \
         systemctl mask "${unit}"; done \
    && for unit in $(rpm -ql virtualbox-guest-additions | grep -E '\.service$' | xargs -r -n1 basename); do \
         systemctl enable "${unit}" || true; done \
    && /usr/libexec/aegis-build/clean-package-state \
    && /usr/libexec/aegis-build/var-to-tmpfiles finish aegis-gui \
    && test ! -e /etc/xdg/kwinrc

# AEGIS identity: look-and-feel package, colour scheme, wallpaper, AEGIS mark, the
# design-token QML module org.aegisos.style, the AEGIS Security widget and its read-only
# status helper (under /usr), the display manager preset (under /usr/lib), and KWin's
# system defaults for blur and the on-screen keyboard (/etc/xdg/kwinrc; checked above
# that Fedora ships no such file).
COPY image/rootfs-gui/ /

# Select the AEGIS look-and-feel for every user (the only /etc change of this variant),
# enable the display manager and boot to the graphical target.
RUN mkdir -p /etc/xdg \
    && echo "/etc/xdg/kdeglobals before AEGIS:" && { cat /etc/xdg/kdeglobals 2> /dev/null || true; } \
    && cat /usr/share/aegis/xdg/kdeglobals.aegis >> /etc/xdg/kdeglobals \
    && printf '[KDE]\nLookAndFeelPackage=org.aegisos.desktop\n' >> /etc/xdg/kdeglobals \
    && systemctl preset sddm.service \
    && systemctl --global enable aegis-flathub-user-remote.service \
    && systemctl set-default graphical.target \
    && test -L /etc/systemd/system/display-manager.service \
    && rm -rf /usr/libexec/aegis-build

# v3 hybrid desktop (M10): the AEGIS login screen must be the one SDDM uses (nothing in
# /etc may choose another theme), and its parts, the new panel widgets, the Quick
# Settings helper and the approved packages (Inter, Spectacle, Orca) must be present.
RUN test -f /usr/share/sddm/themes/aegis/Main.qml \
    && grep -q '^Current=aegis$' /usr/lib/sddm/sddm.conf.d/zz-aegis-theme.conf \
    && echo "SDDM theme settings in /usr/lib and /etc:" \
    && { grep -rHs '^Current=' /usr/lib/sddm/sddm.conf.d /etc/sddm.conf.d /etc/sddm.conf || true; } \
    && test -z "$(grep -rls '^Current=' /etc/sddm.conf.d /etc/sddm.conf 2> /dev/null)" \
    && test "$(ls /usr/lib/sddm/sddm.conf.d | sort | tail -n 1)" = zz-aegis-theme.conf \
    && test -x /usr/libexec/aegis/quick-settings \
    && test -f /usr/share/plasma/plasmoids/org.aegisos.quicksettings/contents/ui/main.qml \
    && test -f /usr/share/plasma/plasmoids/org.aegisos.activewindow/contents/ui/main.qml \
    && fc-list : family | tr ',' '\n' | grep -qx 'Inter' \
    && command -v spectacle && command -v orca \
    && python3 -c "import pyatspi; print('accessibility stack (pyatspi) loads')"

# KDE Wallet with the login password (kwallet-pam, docs/architecture/v3-kwallet.md):
# SDDM's password login must hand the typed password to pam_kwallet (auth) and start
# the wallet with the derived key (session). The image must not contain a wallet or a
# wallet salt; whatever wallet settings packages ship are printed as evidence.
RUN echo "KDE Wallet in SDDM's PAM stacks:" \
    && { grep -Hn kwallet /etc/pam.d/sddm /etc/pam.d/sddm-autologin /etc/pam.d/sddm-greeter || true; } \
    && test -f /usr/lib64/security/pam_kwallet5.so \
    && test -n "$(find /usr/libexec /usr/lib -name pam_kwallet_init 2> /dev/null)" \
    && grep -Eq '^-?auth[[:space:]]+optional[[:space:]]+pam_kwallet5\.so' /etc/pam.d/sddm \
    && grep -Eq '^-?session[[:space:]]+optional[[:space:]]+pam_kwallet5\.so[[:space:]]+auto_start' /etc/pam.d/sddm \
    && echo "Wallet settings shipped by packages:" \
    && { find /etc /usr/share -name kwalletrc -print -exec cat {} \; 2> /dev/null || true; } \
    && test -z "$(find / -xdev \( -name '*.kwl' -o -name '*.salt' -path '*kwalletd*' \) 2> /dev/null)"

LABEL org.opencontainers.image.title="AEGIS OS (graphical development, GUI v1)"

RUN bootc container lint --fatal-warnings
