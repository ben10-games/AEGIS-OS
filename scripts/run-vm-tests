#!/usr/bin/env bash
# Boot the disk image in QEMU inside the builder container and run the VM tests.
#
#   scripts/run-vm-tests [extra pytest arguments...]
#
# Boots out/disk.raw (aegis-dev) and out/disk-base.raw (aegis-base).
#
# Uses KVM when /dev/kvm is usable. Without it the tests fall back to software
# emulation, which is far slower and is reported in the test output.
set -euo pipefail

cd "$(dirname "$0")/.."

disk=out/disk.raw
base_disk=out/disk-base.raw

for file in "${disk}" "${base_disk}"; do
  if [[ ! -f "${file}" ]]; then
    echo "error: disk image ${file} not found; run 'make disk' first" >&2
    exit 1
  fi
done
if ! compgen -G "out/release/*.qcow2" >/dev/null; then
  echo "error: no exported image in out/release; run 'make export' first" >&2
  exit 1
fi

as_root=()
if [[ "${EUID}" -ne 0 ]]; then
  as_root=(sudo)
fi

accel=tcg
kvm_args=()
if [[ -r /dev/kvm && -w /dev/kvm ]]; then
  accel=kvm
  kvm_args=(--device /dev/kvm)
fi
echo "== virtual machine acceleration: ${accel}"

revision="$(git rev-parse HEAD 2>/dev/null || echo unknown)"
if [[ -n "$(git status --porcelain 2>/dev/null || true)" ]]; then
  revision="${revision}-dirty"
fi

mkdir -p out/vm

# QEMU's DNS forwarder (10.0.2.3) sends the guest's queries to the nameserver in the
# container's /etc/resolv.conf. The network tests answer them with a DNS server on the
# container's loopback (tests/vm/harness/servers.py), so that is the only nameserver.
# Set explicitly: an image built without network can carry a resolv.conf naming a
# server that does not exist here (V-10 failed that way in run 44731480599).
printf 'nameserver 127.0.0.1\n' > out/vm/resolv.conf

# No network for the container: the tests talk to the guest over a forwarded port on
# the container's own loopback interface, and nothing here needs the internet.
"${as_root[@]}" podman run --rm \
  "${kvm_args[@]}" \
  --network=none \
  -v "${PWD}/out/vm/resolv.conf:/etc/resolv.conf:ro" \
  --security-opt label=disable \
  -v "${PWD}:/work" \
  -w /work \
  -e "AEGIS_VM_ACCEL=${accel}" \
  -e "AEGIS_EXPECT_REVISION=${revision}" \
  localhost/aegis-builder:latest \
  python3 -m pytest tests/vm --ignore=tests/vm/test_gui.py \
  --ignore=tests/vm/test_local_gui_image.py --ignore=tests/vm/test_live_iso.py --ignore=tests/vm/test_live_flatpak.py \
  --ignore=tests/vm/test_v3_vdi.py --ignore=tests/vm/test_v3_apps.py \
  -p no:cacheprovider \
  -v \
  --disk "${disk}" \
  --base-disk "${base_disk}" \
  --workdir out/vm \
  --junitxml out/junit-vm.xml \
  "$@"
