#!/usr/bin/env bash
# Print the key evidence from a build-and-boot run (out/) as plain text.
# CI writes this to the job log and the run summary, so a session that cannot
# download artifacts can still read what actually happened.
#
# Order matters, because a job log can only be read from its end:
#   1. bulky lists that rarely change (packages, enabled units)
#   2. diagnostics
#   3. short inventories (privileged files, listeners, services)
#   4. verdict: measurements and test reports
set -euo pipefail

cd "$(dirname "$0")/.."

logs=out/vm/logs
inventory=out/inventory

section() {
  local title="$1" file="$2" lines="${3:-40}"
  echo "=== ${title}"
  if [[ -s "${file}" ]]; then
    head -n "${lines}" "${file}"
  elif [[ -e "${file}" ]]; then
    echo "(empty)"
  else
    echo "(not recorded: ${file} is missing)"
  fi
  echo
}

# Print a one-item-per-line list as wrapped lines to keep the log short.
wrapped() {
  local title="$1" file="$2"
  if [[ -s "${file}" ]]; then
    echo "=== ${title} ($(wc -l < "${file}") entries)"
    paste -sd' ' "${file}" | fold -s -w 150
  elif [[ -e "${file}" ]]; then
    echo "=== ${title} (0 entries)"
  else
    echo "=== ${title} (not recorded: ${file} is missing)"
  fi
  echo
}

if [[ ! -d "${inventory}" && ! -d "${logs}" ]]; then
  echo "##### NOTHING TO SUMMARIZE: no inventory and no VM logs under out/."
  echo "The build stopped before producing them; the error is above this step in the log."
  exit 0
fi

echo "##### 1. BULKY LISTS"
wrapped "golden:base/packages.txt" "${inventory}/base/packages.txt"
wrapped "golden:base/enabled-units.txt" "${inventory}/base/enabled-units.txt"
wrapped "enabled units at runtime (aegis-dev)" "${logs}/boot1-enabled-units.txt"

echo "##### 2. DIAGNOSTICS (aegis-dev, first boot)"
section "bootc status" "${logs}/boot1-bootc-status.txt" 45
section "identity" "${logs}/boot1-os-release.txt" 40
section "block devices" "${logs}/boot1-lsblk.txt"
section "disk layout" out/disk-layout.txt
section "preset files" "${logs}/boot1-presets.txt" 30
section "timers" "${logs}/boot1-timers.txt" 25
section "ssh listeners and units" "${logs}/boot1-ssh-listeners.txt" 30
section "SELinux policy status and module store" "${logs}/boot1-selinux-store.txt" 30
section "boot chain: firmware, boot loader, kernel, root" "${logs}/boot1-boot-chain.txt" 110
section "EFI system partition" "${logs}/boot1-esp.txt" 80
section "SELinux: types of the boot directories" "${logs}/selinux-boot-directories.txt" 20
section "SELinux: processes per domain" "${logs}/boot1-process-domains.txt" 60

echo "##### 3. SHORT INVENTORIES"
section "sealed structure of aegis-base (B-06)" "${inventory}/base/sealed.txt" 20
section "sealed structure of aegis-dev (B-06)" "${inventory}/dev/sealed.txt" 20
wrapped "golden:base/masked-units.txt" "${inventory}/base/masked-units.txt"
section "golden:base/setuid-files.txt" "${inventory}/base/setuid-files.txt" 80
section "golden:base/file-capabilities.txt" "${inventory}/base/file-capabilities.txt" 40
wrapped "golden:base/selinux-permissive-domains.txt" \
  "${inventory}/base/selinux-permissive-domains.txt"
section "golden:base/etc-changes.txt (A added, M modified, D deleted vs upstream base)" \
  "${inventory}/base/etc-changes.txt" 80
echo "--- aegis-dev compared with aegis-base (+ added, - removed)"
for name in packages enabled-units masked-units setuid-files file-capabilities etc-changes; do
  section "golden:dev/${name}.delta.txt" "${inventory}/dev/${name}.delta.txt" 60
done
echo "=== fingerprints of files added or modified under /etc (aegis-base)"
if [[ -s "${inventory}/base/etc-changes.txt" && -s "${inventory}/base/etc.tsv" ]]; then
  awk '$1 != "D" {print $2}' "${inventory}/base/etc-changes.txt" \
    | while IFS= read -r path; do
      awk -F'\t' -v path="${path}" '$1 == path {print $1, $2}' "${inventory}/base/etc.tsv"
    done | head -n 60
else
  echo "(none)"
fi
echo

echo "=== differences between the golden manifests and this build (< golden, > image)"
for variant in base dev; do
  for golden in tests/golden/"${variant}"/*.txt; do
    actual="${inventory}/${variant}/$(basename "${golden}")"
    [[ -f "${actual}" ]] || { echo "${actual} was not produced"; continue; }
    difference="$(diff <(grep -Ev '^(#|$)' "${golden}" || true) "${actual}" | grep '^[<>]' || true)"
    if [[ -n "${difference}" ]]; then
      echo "--- ${variant}/$(basename "${golden}")"
      echo "${difference}" | head -n 60
    fi
  done
done
echo "(end of differences)"
echo

echo "--- runtime, aegis-dev, first boot"
wrapped "running services" "${logs}/boot1-running-services.txt"
wrapped "active timers" "${logs}/boot1-active-timers.txt"
section "listening TCP/UDP sockets" "${logs}/boot1-listening-sockets.txt" 40
section "listening vsock sockets" "${logs}/boot1-listening-vsock.txt" 10
section "accounts" "${logs}/boot1-accounts.txt" 20
section "kernel messages at error level" "${logs}/boot1-kernel-errors.txt" 30
section "SELinux: unlabeled_t and default_t files" "${logs}/boot1-selinux-labels.txt" 45
section "audit: event types recorded since boot" "${logs}/audit-event-types.txt" 25
section "reverse-path filter experiment" "${logs}/rp-filter-experiment.txt" 3
echo "=== disk installation: SELinux notes and label corrections"
grep -hiE 'selinux|relabel|census|physical root' out/install-*.log 2>/dev/null | sort | uniq -c | head -n 20 \
  || echo "(no install log)"
echo
section "SELinux: denials during boot (V-08)" "${logs}/selinux-denials-at-boot.txt" 12
section "SELinux: denial caused by the self-test" "${logs}/selinux-selftest-denial.txt" 4
echo "=== firewall: kernel rules that mention the aegis zone or a drop"
if [[ -s "${logs}/firewall-ruleset.txt" ]]; then
  grep -nE 'chain filter_(INPUT|IN_aegis|INPUT_POLICIES)|aegis|drop' \
    "${logs}/firewall-ruleset.txt" | head -n 40
else
  echo "(not recorded)"
fi
echo

echo "##### 4. VERDICT"
section "build" out/build-info.txt
section "test container packages" out/builder-versions.txt

for boot in boot1 boot2; do
  section "${boot}: startup time" "${logs}/${boot}-systemd-analyze.txt" 2
  section "${boot}: failed units" "${logs}/${boot}-failed-units.txt"
  section "${boot}: SELinux denials" "${logs}/${boot}-avc.txt" 12
done
section "measurements (first boot)" "${logs}/boot1-metrics.json" 60

echo "=== failures reported on the serial consoles (all boots)"
grep -haE 'FAILED|Failed to start|denied|Kernel panic|Security Violation|Access Denied|verification failed' \
  "${logs}"/*-serial*.log 2>/dev/null | sed -E 's/\x1b\[[0-9;?]*[A-Za-z]//g; s/^\[ *[0-9.]+\] //' \
  | cut -c1-200 | sort | uniq -c | sort -rn | head -n 30 || echo "(none)"
echo

echo "=== diagnostics printed on the console of the first development boot"
first="$(ls "${logs}"/test_boot-serial-boot1.log 2>/dev/null | head -n 1)"
if [[ -n "${first}" ]]; then
  sed -E 's/\x1b\[[0-9;?]*[A-Za-z]//g' "${first}" | tr -d '\r' \
    | sed -n '/AEGIS-DIAG BEGIN/,/AEGIS-DIAG END/p' | cut -c1-220 | head -n 120
else
  echo "(no console log)"
fi
echo

# When a virtual machine never answers, its console is the only evidence.
for console in "${logs}"/*-serial*.log; do
  [[ -s "${console}" ]] || continue
  if ! grep -qE 'login:|Power down' "${console}"; then
    echo "=== console without a login prompt: $(basename "${console}") (last lines)"
    tail -n 40 "${console}" | sed -E 's/\x1b\[[0-9;?]*[A-Za-z]//g' | tr -d '\r' | cut -c1-220
    echo
  fi
done

echo "=== aegis-base console (last lines of the first boot)"
if [[ -s "${logs}/test_base_boot-serial-boot1.log" ]]; then
  tail -n 14 "${logs}/test_base_boot-serial-boot1.log" \
    | sed -E 's/\x1b\[[0-9;?]*[A-Za-z]//g' | tr -d '\r'
else
  echo "(no data)"
fi
echo

section "exported image for local testing" out/release/IMAGE-INFO.txt 12
section "checksums of the exported files" out/release/SHA256SUMS 6
section "exported image: how the console login happened" "${logs}/local-image-console.txt" 14
echo "=== exported image: console of the launcher test (last lines)"
if [[ -s "${logs}/local-image-serial.log" ]]; then
  tail -n 8 "${logs}/local-image-serial.log" | sed -E 's/\x1b\[[0-9;?]*[A-Za-z]//g' | tr -d '\r'
else
  echo "(no data)"
fi
echo

for report in out/junit-*.xml; do
  [[ -f "${report}" ]] || continue
  echo "=== test report ${report}"
  { grep -oE '<testsuite [^>]*>' "${report}" || true; } \
    | { grep -oE '(tests|failures|errors|skipped|time)="[^"]*"' || true; } \
    | tr '\n' ' '
  echo
  { grep -oE '<testcase [^>]*name="[^"]*"' "${report}" || true; } \
    | sed -E 's/.*name="([^"]*)".*/  ran: \1/'
  { grep -oE '<(failure|error) message="[^"]{0,400}' "${report}" || true; } \
    | sed -E 's/^<(failure|error) message="/  FAILED: /; s/&#10;/ | /g; s/&quot;/"/g'
  echo
done
