#!/usr/bin/env bash
# Record what is inside the aegis-base and aegis-dev images: packages, enabled and
# masked units, setuid/setgid files, file capabilities and SELinux permissive domains.
#
# Output goes to out/inventory/<variant>/. The golden manifests in tests/golden/ are
# compared against these files (tests/image/), and are updated from them.
#
# Each image is mounted read-only at /target and inspected offline; nothing in it runs.
set -euo pipefail

cd "$(dirname "$0")/.."

as_root=()
if [[ "${EUID}" -ne 0 ]]; then
  as_root=(sudo)
fi

builder=localhost/aegis-builder:latest
out=out/inventory
upstream="$(grep -E '^BASE_IMAGE=' image/base.lock | cut -d= -f2-)"

# inspect IMAGE COMMAND...: run COMMAND in a throw-away container of IMAGE itself, with
# IMAGE also mounted read-only at /target. No network.
inspect() {
  local image="$1"
  shift
  "${as_root[@]}" podman run --rm --network=none \
    --mount "type=image,source=${image},destination=/target" \
    "${image}" "$@"
}

# etc_manifest IMAGE: one "path<TAB>fingerprint" line per file or symlink under /etc.
etc_manifest() {
  inspect "$1" sh -c '
    cd /target/etc
    find . -xdev -type f -exec sha256sum {} + | sed -E "s/^([0-9a-f]+) [ *]\.\/(.*)$/\2\t\1/"
    find . -xdev -type l -printf "%P\tlink:%l\n"
  ' | LC_ALL=C sort
}

# etc_changes UPSTREAM_MANIFEST IMAGE_MANIFEST: files added (A), modified (M) or deleted (D)
# under /etc relative to the pinned upstream base. The SELinux policy store is one entry:
# installing a policy module rewrites many generated files there.
etc_changes() {
  awk -F'\t' '
    NR == FNR { upstream[$1] = $2; next }
    { seen[$1] = 1
      if (!($1 in upstream)) print "A " $1
      else if (upstream[$1] != $2) print "M " $1 }
    END { for (path in upstream) if (!(path in seen)) print "D " path }
  ' "$1" "$2" \
    | sed -E 's#^[AMD] selinux/targeted/.*#M selinux/targeted/** (policy store)#' \
    | LC_ALL=C sort -u | LC_ALL=C sort -k2
}

mkdir -p "${out}"
echo "== /etc manifest of the upstream base ${upstream}"
etc_manifest "${upstream}" > "${out}/upstream-etc.tsv"

for variant in base dev; do
  image="localhost/aegis-${variant}:latest"
  dir="${out}/${variant}"
  mkdir -p "${dir}"
  echo "== inventory of ${image}"

  inspect "${image}" rpm -qa --qf '%{NAME}.%{ARCH}\n' \
    | { grep -v '^gpg-pubkey\.' || true; } | LC_ALL=C sort -u > "${dir}/packages.txt"

  inspect "${image}" systemctl --root=/target list-unit-files \
    --state=enabled --no-legend --no-pager \
    | awk '{print $1}' | LC_ALL=C sort -u > "${dir}/enabled-units.txt"

  # systemctl exits non-zero when no unit file matches; an empty list is a valid answer.
  { inspect "${image}" systemctl --root=/target list-unit-files \
    --state=masked --no-legend --no-pager || true; } \
    | awk '{print $1}' | LC_ALL=C sort -u > "${dir}/masked-units.txt"

  # /sysroot holds the ostree object store: content-addressed copies of the same files
  # under hash names that change with every build. The real paths are listed instead.
  inspect "${image}" find /target -xdev -path /target/sysroot -prune -o \
    -type f -perm /6000 -printf '%m %u:%g /%P\n' \
    | LC_ALL=C sort -k3 > "${dir}/setuid-files.txt"

  { inspect "${image}" getcap -r /target 2>/dev/null || true; } \
    | sed 's#^/target##' | { grep -v '^/sysroot/' || true; } \
    | LC_ALL=C sort > "${dir}/file-capabilities.txt"

  if "${as_root[@]}" podman image exists "${builder}"; then
    "${as_root[@]}" podman run --rm --network=none \
      --mount "type=image,source=${image},destination=/target" \
      "${builder}" sh -c 'seinfo --permissive /target/etc/selinux/targeted/policy/policy.*' \
      | awk 'seen && NF {print $1} /^Permissive Types:/ {seen=1}' \
      | LC_ALL=C sort -u > "${dir}/selinux-permissive-domains.txt"
  else
    echo "note: ${builder} not built; SELinux permissive domains not listed"
  fi

  etc_manifest "${image}" > "${dir}/etc.tsv"
  etc_changes "${out}/upstream-etc.tsv" "${dir}/etc.tsv" > "${dir}/etc-changes.txt"

  wc -l "${dir}"/*.txt
done

# What the development variant adds (+) or removes (-) compared with the release variant.
for name in packages enabled-units masked-units setuid-files file-capabilities etc-changes; do
  {
    LC_ALL=C comm -13 "${out}/base/${name}.txt" "${out}/dev/${name}.txt" | sed 's/^/+/'
    LC_ALL=C comm -23 "${out}/base/${name}.txt" "${out}/dev/${name}.txt" | sed 's/^/-/'
  } > "${out}/dev/${name}.delta.txt"
done
echo "== dev variant delta"
wc -l "${out}"/dev/*.delta.txt
