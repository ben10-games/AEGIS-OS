#!/usr/bin/env bash
# Compare the image inventory (out/inventory/) with the golden manifests (tests/golden/).
# Runs pytest inside the builder container, offline. Run 'make inventory' first.
set -euo pipefail

cd "$(dirname "$0")/.."

if [[ ! -d out/inventory/base ]]; then
  echo "error: out/inventory not found; run 'make inventory' first" >&2
  exit 1
fi

as_root=()
if [[ "${EUID}" -ne 0 ]]; then
  as_root=(sudo)
fi

"${as_root[@]}" podman run --rm \
  --network=none \
  --security-opt label=disable \
  -v "${PWD}:/work" \
  -w /work \
  localhost/aegis-builder:latest \
  python3 -m pytest tests/image \
  -p no:cacheprovider \
  -v \
  --junitxml out/junit-image.xml \
  "$@"
