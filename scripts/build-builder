#!/usr/bin/env bash
# Build the test and tooling container (QEMU, UEFI firmware, software TPM, pytest)
# from the same digest-pinned base as the operating-system image.
set -euo pipefail

cd "$(dirname "$0")/.."

base_image="$(grep -E '^BASE_IMAGE=' image/base.lock | cut -d= -f2-)"
if [[ "${base_image}" != *@sha256:* ]]; then
  echo "error: image/base.lock must pin the base image by digest" >&2
  exit 1
fi

as_root=()
if [[ "${EUID}" -ne 0 ]]; then
  as_root=(sudo)
fi

# Locked inputs (P1-15): the RPMs verified by scripts/fetch-inputs are the only package
# source. Builds run without network; file times are the commit time, so two builds
# of one commit can be compared (R-02).
inputs=out/inputs/rpms
if [[ ! -s "${inputs}/base/SHA256SUMS" ]]; then
  echo "INPUT ERROR: no verified RPM inputs in ${inputs}; run scripts/fetch-inputs" >&2
  exit 1
fi
epoch="${SOURCE_DATE_EPOCH:-$(git log -1 --format=%ct 2>/dev/null || echo 0)}"
locked=(
  --network=none
  --build-context "rpms=${inputs}"
  --timestamp "${epoch}"
  --build-arg "SOURCE_DATE_EPOCH=${epoch}"
)

"${as_root[@]}" podman build \
  --pull=missing \
  "${locked[@]}" \
  --build-context helpers=image/build \
  --build-arg "BASE_IMAGE=${base_image}" \
  --tag localhost/aegis-builder:latest \
  --file build/builder/Containerfile \
  build/builder

mkdir -p out
"${as_root[@]}" podman run --rm localhost/aegis-builder:latest \
  rpm -q qemu-system-x86-core edk2-ovmf swtpm openssh-clients python3-pytest setools-console \
    systemd-ukify systemd-boot-unsigned sbsigntools python3-virt-firmware mtools \
  | tee out/builder-versions.txt
