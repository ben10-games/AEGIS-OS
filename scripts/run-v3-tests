#!/usr/bin/env bash
# AEGIS OS v3 (M8): test the persistent desktop disk. Offline, in the tools container.
#   1. tests/vm/test_secure_boot.py on out/disk-v3.raw under Secure Boot with this
#      build's keys (the sealed boot chain of the v3 image, QEMU q35);
#   2. tests/vm/test_v3_vdi.py on the exported VDI on VirtualBox-like hardware without
#      Secure Boot keys (first-boot setup, login, persistence over a power-off);
#   3. tests/vm/test_v3_apps.py with network (Flathub, Google's download server): Chrome
#      installed by the user persists over a power-off. AEGIS_V3_SKIP_NETWORK_TESTS=1
#      leaves it out.
# The v3 image has its SSH server disabled; AEGIS_TEST_SSH_UNIT=1 makes the harness pass
# a one-boot SSH unit as a firmware credential. Both suites run; fails if either failed.
set -euo pipefail

cd "$(dirname "$0")/.."

if ! compgen -G "out/release-v3/*.vdi" > /dev/null || [[ ! -f out/disk-v3.raw ]]; then
  echo "error: run scripts/build-disk and scripts/export-vdi for v3 first" >&2
  exit 1
fi

as_root=()
if [[ "${EUID}" -ne 0 ]]; then
  as_root=(sudo)
fi
kvm_args=()
accel=tcg
if [[ -r /dev/kvm && -w /dev/kvm ]]; then
  accel=kvm
  kvm_args=(--device /dev/kvm)
fi

mkdir -p out/vm-v3
run_suite() { # NETWORK JUNIT PYTEST-ARGS...
  local network="$1" junit="$2"
  shift 2
  "${as_root[@]}" podman run --rm \
    "${kvm_args[@]}" \
    "--network=${network}" \
    --security-opt label=disable \
    -v "${PWD}:/work" \
    -w /work \
    -e "AEGIS_VM_ACCEL=${accel}" \
    -e AEGIS_TEST_SSH_UNIT=1 \
    localhost/aegis-builder:latest \
    python3 -m pytest "$@" \
    -p no:cacheprovider \
    -v \
    --workdir out/vm-v3 \
    --junitxml "${junit}"
}

status=0
run_suite none out/junit-v3-secureboot.xml tests/vm/test_secure_boot.py \
  --disk out/disk-v3.raw --sealed-variant v3 || status=1
run_suite none out/junit-v3.xml tests/vm/test_v3_vdi.py || status=1
if [[ "${AEGIS_V3_SKIP_NETWORK_TESTS:-0}" != 1 ]]; then
  run_suite bridge out/junit-v3-apps.xml tests/vm/test_v3_apps.py || status=1
fi
exit "${status}"
