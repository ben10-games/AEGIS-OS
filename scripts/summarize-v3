#!/usr/bin/env bash
# Print the evidence of the v3 disk build and tests to the job log: screenshots first
# (base64 PNG, scripts/print_screenshots.py), then build information, test records and
# the test reports last (the log is read through an excerpt of its end).
set -euo pipefail

cd "$(dirname "$0")/.."
logs=out/vm-v3/logs

# AEGIS_SUMMARY_SCREENSHOTS=0: text only (the TEST-REPORT.txt of the download).
if [[ "${AEGIS_SUMMARY_SCREENSHOTS:-1}" != 0 ]]; then
  python3 scripts/print_screenshots.py "${logs}" v3 greeter-desktop:3 desktop-1920-dark:3 \
    desktop-1920-light:4 quick-settings:4 welcome-3-start:4 welcome-3:4 welcome-4:4 welcome-6:4 \
    welcome-7:4 appcenter-firefox:4 appcenter-installed:4
fi

section() {
  echo "=== $1"
  if [[ -s "$2" ]]; then head -n "${3:-40}" "$2"; else echo "(not recorded: $2)"; fi
  echo
}

section "v3: BUILD-INFO.txt" out/release-v3/BUILD-INFO.txt
section "v3: SHA256SUMS" out/release-v3/SHA256SUMS
for name in vdi timings release account system persistence apps apps-denials update update-denials desktop desktop-qml-errors desktop-denials welcome welcome-apps welcome-qml-errors welcome-denials appcenter appcenter-denials performance; do
  section "v3: ${name}" "${logs}/v3-${name}.txt" 60
done
echo "=== v3: console failures"
grep -haE 'FAILED|Failed to start|denied' "${logs}"/v3*serial*.log 2> /dev/null \
  | sed -E 's/\x1b\[[0-9;?]*[A-Za-z]//g; s/^\[ *[0-9.]+\] //' | cut -c1-200 \
  | sort | uniq -c | sort -rn | head -n 20 || echo "(none)"
echo

for report in out/junit-v3-secureboot.xml out/junit-v3.xml out/junit-v3-desktop.xml out/junit-v3-welcome.xml out/junit-v3-performance.xml out/junit-v3-apps.xml out/junit-v3-appcenter.xml out/junit-v3-update.xml; do
  [[ -f "${report}" ]] || continue
  echo "=== test report ${report}"
  grep -o 'errors="[0-9]*" failures="[0-9]*" skipped="[0-9]*" tests="[0-9]*" time="[0-9.]*"' \
    "${report}" | head -n 1
  python3 - "${report}" << 'PYTHON'
import sys, xml.etree.ElementTree as ET
for case in ET.parse(sys.argv[1]).iter("testcase"):
    problem = case.find("failure") if case.find("failure") is not None else case.find("error")
    state = "ran" if problem is None else "FAILED"
    message = "" if problem is None else ": " + (problem.get("message") or "")[:400].replace("\n", " | ")
    print(f"  {state}: {case.get('name')}{message}")
PYTHON
done
