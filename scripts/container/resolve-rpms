#!/usr/bin/env bash
# Runs inside a container of the pinned base image, with network access to the Fedora
# repositories, for scripts/bump-inputs only (never during an image build).
#
#   resolve-rpms os|builder
#
# Reproduces the starting state of each install step (rpms.in.yaml), lets dnf resolve
# the requested names against it with weak dependencies off, and downloads exactly the
# packages that step would install into /out/rpms/<step>/. Writes /out/metadata.tsv and
# /out/repos.tsv for scripts/rpmlock.py. Requested names are read from /in/<step>.txt.
set -euo pipefail

mode="$1"
# fedora-cisco-openh264 serves a Cisco-built binary from Cisco's own host; AEGIS takes
# packages from Fedora's repositories only (the stub noopenh264 stands in for it).
dnf_opts=(-y --setopt=install_weak_deps=False --disablerepo=fedora-cisco-openh264)

# name@other -> name-<version>-<release of other as installed here>
expand() {
  local entry name other
  while read -r entry; do
    [[ -n "${entry}" ]] || continue
    if [[ "${entry}" == *@* ]]; then
      name="${entry%@*}"
      other="${entry#*@}"
      echo "${name}-$(rpm -q --qf '%{VERSION}-%{RELEASE}' "${other}")"
    else
      echo "${entry}"
    fi
  done < "/in/$1.txt"
}

download() {
  local step="$1" packages present=() name
  mapfile -t packages < <(expand "${step}")
  # A requested name that the starting state already has would not be locked, and the
  # lock could not show that it is present; rpms.in.yaml must not list it.
  for name in "${packages[@]}"; do
    if rpm -q --quiet "${name}"; then
      present+=("${name}")
    fi
  done
  if [[ "${#present[@]}" -gt 0 ]]; then
    echo "error: ${step}: already installed in the starting state: ${present[*]}" >&2
    echo "       remove these names from that step in rpms.in.yaml" >&2
    exit 1
  fi
  echo "== ${step}: ${packages[*]}"
  mkdir -p "/out/rpms/${step}"
  # dnf 5 has no --destdir for install: the packages are taken from its cache, which is
  # emptied of packages first so that only this step's downloads are collected.
  find /var/cache/libdnf5 -name '*.rpm' -delete 2> /dev/null || true
  dnf "${dnf_opts[@]}" --setopt=keepcache=True install --downloadonly "${packages[@]}"
  find /var/cache/libdnf5 -name '*.rpm' -exec mv -t "/out/rpms/${step}" {} +
  if ! compgen -G "/out/rpms/${step}/*.rpm" > /dev/null; then
    echo "error: dnf downloaded nothing for ${step}" >&2
    exit 1
  fi
}

case "${mode}" in
  os)
    # image/Containerfile: the same removals, then the base step.
    rpm -e bootupd shim-x64
    dnf -y remove openssh-server
    download base
    # The base step must install from its own files alone (no repository): this proves
    # the locked set is complete before anything else is resolved on top of it.
    dnf "${dnf_opts[@]}" --disablerepo='*' install /out/rpms/base/*.rpm
    download dev
    download dev-policy
    # The graphical image is built on aegis-dev: install the dev step offline, then
    # resolve the gui step on that state.
    dnf "${dnf_opts[@]}" --disablerepo='*' install /out/rpms/dev/*.rpm
    download gui
    # The Live ISO's initramfs stage is built on aegis-gui: install the gui step offline,
    # then resolve the live step on that state.
    dnf "${dnf_opts[@]}" --disablerepo='*' install /out/rpms/gui/*.rpm
    download live
    download apps-build
    ;;
  builder)
    download builder
    ;;
  *)
    echo "usage: resolve-rpms os|builder" >&2
    exit 2
    ;;
esac

# One line per downloaded file, and where each package came from.
: > "/out/metadata-${mode}.tsv"
nevras=()
for file in /out/rpms/*/*.rpm; do
  step="$(basename "$(dirname "${file}")")"
  case "${mode}:${step}" in
    os:base | os:dev | os:dev-policy | os:gui | os:live | os:apps-build | builder:builder) ;;
    *) continue ;;
  esac
  header="$(rpm -qp --nosignature --nodigest \
    --qf '%{NAME}\t%{EPOCHNUM}\t%{VERSION}\t%{RELEASE}\t%{ARCH}' "${file}")"
  read -r size < <(stat -c %s "${file}")
  sha="$(sha256sum "${file}" | cut -d' ' -f1)"
  printf '%s\t%s\t%s\t%s\t%s\n' "${step}" "${header}" "${sha}" "${size}" \
    "$(basename "${file}")" >> "/out/metadata-${mode}.tsv"
  nevras+=("$(rpm -qp --nosignature --nodigest --qf '%{NAME}-%{EPOCHNUM}:%{VERSION}-%{RELEASE}.%{ARCH}' "${file}")")
done
mapfile -t nevras < <(printf '%s\n' "${nevras[@]}" | sort -u)
dnf -q repoquery --available --disablerepo=fedora-cisco-openh264 \
  --qf $'%{name}\t%{epoch}\t%{version}\t%{release}\t%{arch}\t%{repoid}\t%{location}\n' \
  "${nevras[@]}" > "/out/repos-${mode}.tsv"
echo "== ${mode}: $(wc -l < "/out/metadata-${mode}.tsv") packages"
