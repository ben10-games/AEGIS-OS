#!/usr/bin/env bash
# Runs in the tools container (localhost/aegis-builder), started by scripts/build-live-iso.
#
#   assemble-live-iso ROOTFS BOOT STAGING ISO
#
# ROOTFS   the extracted live root filesystem (written: SELinux labels)
# BOOT     vmlinuz, initrd.img and kernel-version from the 'boot' stage
# STAGING  empty directory for the ISO tree
# ISO      output file
#
# Labels the root filesystem with its own SELinux policy, packs it into a SquashFS with
# the labels, builds the UEFI boot image (Fedora's signed shim and GRUB from this
# container, which comes from the same pinned base as the OS) and writes the ISO.
set -euo pipefail

rootfs="$1"
boot="$2"
staging="$3"
iso="$4"
label=AEGIS_LIVE
here="$(cd "$(dirname "$0")" && pwd)"

echo "== SELinux labels from the image's own policy"
policy_dir="${rootfs}/etc/selinux/targeted"
policies=("${policy_dir}"/policy/policy.*)
policy="$(printf '%s\n' "${policies[@]}" | sort -V | tail -n 1)"
setfiles -F -T 0 -r "${rootfs}" -c "${policy}" \
  "${policy_dir}/contexts/files/file_contexts" "${rootfs}"
for check in usr/bin/bash:shell_exec_t etc/shadow:shadow_t usr/bin/sddm:xdm_exec_t \
  usr/libexec/aegis/live-admin-password:bin_t; do
  context="$(python3 -c 'import os, sys; print(os.getxattr(sys.argv[1], "security.selinux").rstrip(b"\0").decode())' \
    "${rootfs}/${check%%:*}" 2> /dev/null || true)"
  if [[ "${context}" != *":${check#*:}:"* ]]; then
    echo "error: /${check%%:*} is labelled '${context}', expected ${check#*:}" >&2
    exit 1
  fi
  echo "ok: /${check%%:*} ${context}"
done

echo "== live kernel command line"
# The AEGIS kernel arguments of the sealed image (/usr/lib/bootc/kargs.d), unchanged.
kargs="$(sed -e 's/[[:space:]]#.*$//' -e '/^[[:space:]]*#/d' "${rootfs}"/usr/lib/bootc/kargs.d/*.toml \
  | tr '\n' ' ' | grep -oE 'kargs[[:space:]]*=[[:space:]]*\[[^]]*\]' | grep -oE '"[^"]*"' \
  | tr -d '"' | paste -sd' ')"
echo "${kargs}"

echo "== SquashFS of the root filesystem"
mkdir -p "${staging}/LiveOS" "${staging}/images/pxeboot" "${staging}/EFI/BOOT"
mksquashfs "${rootfs}" "${staging}/LiveOS/squashfs.img" \
  -noappend -xattrs -comp zstd -Xcompression-level 19 -b 1M -no-progress -quiet
ls -l "${staging}/LiveOS/squashfs.img"

echo "== kernel, initramfs and boot loader"
cp "${boot}/vmlinuz" "${boot}/initrd.img" "${staging}/images/pxeboot/"
find_efi() {
  local found
  found="$(find /usr/lib/bootupd /usr/lib/efi /boot/efi -name "$1" -type f 2> /dev/null \
    | sort | head -n 1)"
  if [[ -z "${found}" ]]; then
    echo "error: $1 not found in the tools container (shim-x64 / grub2-efi-x64)" >&2
    exit 1
  fi
  echo "${found}"
}
shim="$(find_efi shimx64.efi)"
grub="$(find_efi grubx64.efi)"
mok="$(find_efi mmx64.efi)"
echo "shim: ${shim} ($(rpm -qf "${shim}" 2> /dev/null || echo 'not from a package'))"
echo "grub: ${grub} ($(rpm -qf "${grub}" 2> /dev/null || echo 'not from a package'))"
cp "${shim}" "${staging}/EFI/BOOT/BOOTX64.EFI"
cp "${grub}" "${staging}/EFI/BOOT/grubx64.efi"
cp "${mok}" "${staging}/EFI/BOOT/mmx64.efi"
sed -e "s|@LABEL@|${label}|g" -e "s|@KARGS@|${kargs}|g" "${here}/../../image/live/grub.cfg" \
  > "${staging}/EFI/BOOT/grub.cfg"
grep -q "root=live:CDLABEL=${label}" "${staging}/EFI/BOOT/grub.cfg"

# The El Torito UEFI boot image: a small FAT file system with the same EFI/BOOT tree.
efiboot="${staging}/images/efiboot.img"
size_kib=$(( ($(du -sk "${staging}/EFI" | cut -f1) / 1024 + 4) * 1024 ))
truncate -s "${size_kib}K" "${efiboot}"
mkfs.fat -n AEGISEFI "${efiboot}" > /dev/null
mmd -i "${efiboot}" ::/EFI ::/EFI/BOOT
mcopy -i "${efiboot}" "${staging}"/EFI/BOOT/* ::/EFI/BOOT/
mdir -i "${efiboot}" ::/EFI/BOOT

echo "== ISO"
rm -f "${iso}"
xorriso -as mkisofs -iso-level 3 -full-iso9660-filenames -joliet -joliet-long \
  -rational-rock -volid "${label}" -appid "AEGIS OS Live (development)" \
  -publisher "AEGIS OS project" \
  -e images/efiboot.img -no-emul-boot -isohybrid-gpt-basdat \
  -output "${iso}" "${staging}"
ls -l "${iso}"
