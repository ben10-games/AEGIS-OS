#!/usr/bin/env bash
# Two independent clean builds of the checked-out commit, then the R-01/R-02/R-03 tests
# (tests/repro/test_double_build.py). For a CI runner; needs sudo and about 25 GB.
#
#   REGISTRY_AUTH_FILE=... scripts/repro-build
#
# Build A uses this checkout and root's default container storage. Build B uses a fresh
# clone of the same commit in AEGIS_REPRO_DIR (default /mnt/aegis-repro) with its own
# container storage, fetches and verifies the inputs itself and builds its own builder
# container. Nothing is shared but the commit, the registry and the throw-away keys,
# which are inputs of the build (they are generated by build A and never leave the
# runner). Both builds leave out the update test image (AEGIS_SKIP_UPDATE_IMAGE=1).
set -euo pipefail

cd "$(dirname "$0")/.."

auth="${REGISTRY_AUTH_FILE:?set REGISTRY_AUTH_FILE to the registry login file}"
second="${AEGIS_REPRO_DIR:-/mnt/aegis-repro}"
epoch="$(git log -1 --format=%ct)"

# The builds run as root (separate storage needs root's podman configuration); git
# must accept the runner user's checkouts.
sudo git config --system --add safe.directory '*'

build() { # checkout label [storage-root]
  local checkout="$1" label="$2" storage="${3:-}" settings=()
  if [[ -n "${storage}" ]]; then
    printf '[storage]\ndriver = "overlay"\ngraphroot = "%s"\nrunroot = "/run/aegis-repro-%s"\n' \
      "${storage}" "${label}" | sudo tee "${second}/storage-${label}.conf" > /dev/null
    settings=("CONTAINERS_STORAGE_CONF=${second}/storage-${label}.conf" "AEGIS_STORAGE_ROOT=${storage}")
  fi
  echo "== build ${label} in ${checkout} (storage: ${storage:-default})"
  local start="${SECONDS}"
  sudo env REGISTRY_AUTH_FILE="${auth}" SOURCE_DATE_EPOCH="${epoch}" AEGIS_SKIP_UPDATE_IMAGE=1 \
    "${settings[@]}" bash -c '
      set -euo pipefail
      cd "$1"
      scripts/fetch-inputs
      scripts/build-builder
      scripts/build-image
      scripts/repro-evidence "out/repro/$2"' _ "${checkout}" "${label}"
  echo "== build ${label} took $((SECONDS - start)) s"
}

sudo mkdir -p "${second}"
df -h / "${second}"
build "${PWD}" a

sudo rm -rf "${second}/src" "${second}/storage"
sudo git clone --quiet --no-local "${PWD}" "${second}/src"
test "$(sudo git -C "${second}/src" rev-parse HEAD)" == "$(git rev-parse HEAD)"
sudo cp -a .secrets "${second}/src/.secrets"
build "${second}/src" b "${second}/storage"
df -h / "${second}"

sudo rm -rf out/repro/b
sudo cp -a "${second}/src/out/repro/b" out/repro/b
sudo rm -f out/repro/r03.txt
sudo podman run --rm --network=none --security-opt label=disable \
  -v "${PWD}:/work" -w /work localhost/aegis-builder:latest \
  python3 -m pytest tests/repro -p no:cacheprovider -v --junitxml out/junit-repro.xml
