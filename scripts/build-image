#!/usr/bin/env bash
# Build the sealed aegis-base and aegis-dev container images from the digest-pinned
# base: root filesystem, signed boot loader, signed UKI carrying the root digest.
# Needs podman, the tools container (scripts/build-builder) and access to the base image. Uses sudo when not root, because the disk
# installer later reads the images from root's container storage.
set -euo pipefail

cd "$(dirname "$0")/.."

base_image="$(grep -E '^BASE_IMAGE=' image/base.lock | cut -d= -f2-)"
if [[ "${base_image}" != *@sha256:* ]]; then
  echo "error: image/base.lock must pin the base image by digest" >&2
  exit 1
fi

revision="$(git rev-parse HEAD 2>/dev/null || echo unknown)"
if [[ -n "$(git status --porcelain 2>/dev/null || true)" ]]; then
  revision="${revision}-dirty"
fi
version="${AEGIS_VERSION:-0.1.0-dev}"

as_root=()
if [[ "${EUID}" -ne 0 ]]; then
  as_root=(sudo)
fi

# Fail with an explanation, not a registry error, when the pinned digest is no longer
# served. The pin is never replaced automatically: what goes into the image is reviewed.
if ! "${as_root[@]}" podman pull --quiet "${base_image}" >/dev/null; then
  echo "error: the pinned base image could not be pulled: ${base_image}" >&2
  echo "       If the registry answers 'manifest unknown', the digest is no longer served." >&2
  echo "       Renew the pin as described in image/base.lock." >&2
  exit 1
fi

# Locked inputs (P1-15): the RPMs verified by scripts/fetch-inputs are the only package
# source. Builds run without network; file times are the commit time, so two builds
# of one commit can be compared (R-02).
inputs=out/inputs/rpms
if [[ ! -s "${inputs}/base/SHA256SUMS" ]]; then
  echo "INPUT ERROR: no verified RPM inputs in ${inputs}; run scripts/fetch-inputs" >&2
  exit 1
fi
epoch="${SOURCE_DATE_EPOCH:-$(git log -1 --format=%ct 2>/dev/null || echo 0)}"
locked=(
  --network=none
  --build-context "rpms=${inputs}"
  --timestamp "${epoch}"
  --build-arg "SOURCE_DATE_EPOCH=${epoch}"
)

# Throw-away Secure Boot keys (scripts/dev-keys). The db key signs the boot loader and
# the UKI; it reaches the build as a secret mount and is never written into a layer.
scripts/dev-keys > /dev/null
keys=.secrets/secureboot
secrets=(
  --secret "id=secureboot_key,src=${keys}/db.key"
  --secret "id=secureboot_cert,src=${keys}/db.crt"
)
if ! "${as_root[@]}" podman image exists localhost/aegis-builder:latest; then
  echo "error: localhost/aegis-builder is missing; run scripts/build-builder first" >&2
  exit 1
fi

# Throw-away image signing keys (scripts/signing-keys). Only the public key goes into
# the image, as a build argument.
scripts/signing-keys > /dev/null
signing_pubkey="$("${as_root[@]}" base64 -w0 .secrets/signing/aegis-os.pub)"

echo "== building the base root filesystem from ${base_image}"
"${as_root[@]}" podman build \
  "${locked[@]}" \
  --pull=missing \
  "${secrets[@]}" \
  --build-arg "BASE_IMAGE=${base_image}" \
  --build-arg "AEGIS_VERSION=${version}" \
  --build-arg "AEGIS_REVISION=${revision}" \
  --build-arg "AEGIS_SIGNING_PUBKEY=${signing_pubkey}" \
  --tag localhost/aegis-base-rootfs:latest \
  --file image/Containerfile \
  .

echo "== building the development root filesystem"
"${as_root[@]}" podman build \
  "${locked[@]}" \
  --build-arg "BASE=localhost/aegis-base-rootfs:latest" \
  --build-arg "AEGIS_VERSION=${version}" \
  --build-arg "AEGIS_REVISION=${revision}" \
  --tag localhost/aegis-dev-rootfs:latest \
  --file image/Containerfile.dev \
  .

# AEGIS_SKIP_UPDATE_IMAGE=1 (reproducibility builds) leaves out the update test image.
variants=(base dev dev-v2)
if [[ "${AEGIS_SKIP_UPDATE_IMAGE:-0}" == 1 ]]; then
  variants=(base dev)
else
  echo "== building the update test root filesystem (v2, never released)"
  "${as_root[@]}" podman build \
    "${locked[@]}" \
    --build-arg "BASE=localhost/aegis-dev-rootfs:latest" \
    --tag localhost/aegis-dev-v2-rootfs:latest \
    --file image/Containerfile.update \
    .
fi

# Each variant has its own root filesystem, so each gets its own digest and its own UKI.
# The digest is computed from the root filesystem image in container storage, the way
# 'bootc install' computes it (see image/Containerfile.seal).
mkdir -p out/digests
for variant in "${variants[@]}"; do
  echo "== sealing localhost/aegis-${variant}"
  "${as_root[@]}" podman build \
  "${locked[@]}" \
    --target split \
    --build-arg "ROOTFS=localhost/aegis-${variant}-rootfs:latest" \
    --tag "localhost/aegis-${variant}-split:latest" \
    --file image/Containerfile.seal \
    .
  v1="$(scripts/storage-digest "localhost/aegis-${variant}-split:latest" v1)"
  v2="$(scripts/storage-digest "localhost/aegis-${variant}-split:latest" v2)"
  echo "composefs digest of aegis-${variant} (V1): ${v1}"
  echo "composefs digest of aegis-${variant} (V2): ${v2}"
  "${as_root[@]}" podman build \
  "${locked[@]}" \
    "${secrets[@]}" \
    --build-arg "ROOTFS=localhost/aegis-${variant}-rootfs:latest" \
    --build-arg "COMPOSEFS_DIGEST_V1=${v1}" \
    --build-arg "COMPOSEFS_DIGEST_V2=${v2}" \
    --tag "localhost/aegis-${variant}:latest" \
    --file image/Containerfile.seal \
    .
  # Adding the UKI under /boot must not change the digest of the finished image.
  final="$(scripts/storage-digest "localhost/aegis-${variant}:latest" v1 \
    "out/digests/${variant}-final.dump")"
  if [[ "${final}" != "${v1}" ]]; then
    echo "error: aegis-${variant} has digest ${final}, but its UKI was sealed for ${v1}" >&2
    exit 1
  fi
  echo "ok: aegis-${variant} carries the digest its UKI was sealed for"
  echo "${v1}" > "out/digests/${variant}.v1"
done

# The update image, for the update tests: they push it, signed, to a test registry.
if [[ " ${variants[*]} " == *" dev-v2 "* ]]; then
  mkdir -p out/images
  "${as_root[@]}" rm -f out/images/aegis-dev-v2.oci.tar
  "${as_root[@]}" podman save --format oci-archive -o out/images/aegis-dev-v2.oci.tar \
    localhost/aegis-dev-v2:latest
  "${as_root[@]}" chown -R "$(id -u):$(id -g)" out/images
  ls -l out/images
fi

# The command line each UKI was sealed with (it contains the root digest). The VM tests
# compare the running system's command line with it.
mkdir -p out/sealed
for variant in "${variants[@]}"; do
  "${as_root[@]}" podman run --rm --network=none \
    --mount "type=image,source=localhost/aegis-${variant}:latest,destination=/target" \
    localhost/aegis-builder:latest \
    bash -c 'objcopy -O binary --only-section=.cmdline /target/boot/EFI/Linux/*.efi /dev/stdout' \
    | tr -d '\0' > "out/sealed/${variant}-cmdline.txt"
  echo "sealed command line of aegis-${variant}: $(cat "out/sealed/${variant}-cmdline.txt")"
done

# The public halves, for the tests that enrol them in the virtual firmware.
mkdir -p out/secureboot
cp "${keys}"/{PK,KEK,db,untrusted}.crt "${keys}/owner-guid.txt" out/secureboot/

# B-01: both images must still be marked as bootable containers.
for image in localhost/aegis-base:latest localhost/aegis-dev:latest; do
  label="$("${as_root[@]}" podman image inspect \
    --format '{{ index .Labels "containers.bootc" }}' "${image}")"
  if [[ "${label}" != "1" ]]; then
    echo "error: ${image} lacks the label containers.bootc=1" >&2
    exit 1
  fi
  echo "ok: ${image} containers.bootc=1"
done

mkdir -p out
{
  echo "base_image=${base_image}"
  echo "revision=${revision}"
  echo "version=${version}"
  echo "podman=$(podman --version)"
  echo "source_date_epoch=${epoch}"
  echo "rpm_lock=$(sha256sum image/packages/rpms.lock.yaml | cut -d' ' -f1)"
  for image in localhost/aegis-base:latest localhost/aegis-dev:latest; do
    echo "${image}=$("${as_root[@]}" podman image inspect --format '{{ .Id }}' "${image}")"
  done
} > out/build-info.txt
cat out/build-info.txt
