#!/usr/bin/env bash
# Build the sealed aegis-base and aegis-dev container images from the digest-pinned
# base: root filesystem, signed boot loader, signed UKI carrying the root digest.
# Needs podman, the tools container (scripts/build-builder) and access to the base image. Uses sudo when not root, because the disk
# installer later reads the images from root's container storage.
set -euo pipefail

cd "$(dirname "$0")/.."

base_image="$(grep -E '^BASE_IMAGE=' image/base.lock | cut -d= -f2-)"
if [[ "${base_image}" != *@sha256:* ]]; then
  echo "error: image/base.lock must pin the base image by digest" >&2
  exit 1
fi

revision="$(git rev-parse HEAD 2>/dev/null || echo unknown)"
if [[ -n "$(git status --porcelain 2>/dev/null || true)" ]]; then
  revision="${revision}-dirty"
fi
version="${AEGIS_VERSION:-0.1.0-dev}"

as_root=()
if [[ "${EUID}" -ne 0 ]]; then
  as_root=(sudo)
fi

# Fail with an explanation, not a registry error, when the pinned digest is no longer
# served. The pin is never replaced automatically: what goes into the image is reviewed.
if ! "${as_root[@]}" podman pull --quiet "${base_image}" >/dev/null; then
  echo "error: the pinned base image could not be pulled: ${base_image}" >&2
  echo "       If the registry answers 'manifest unknown', the digest is no longer served." >&2
  echo "       Renew the pin as described in image/base.lock." >&2
  exit 1
fi

# Throw-away Secure Boot keys (scripts/dev-keys). The db key signs the boot loader and
# the UKI; it reaches the build as a secret mount and is never written into a layer.
scripts/dev-keys > /dev/null
keys=.secrets/secureboot
secrets=(
  --secret "id=secureboot_key,src=${keys}/db.key"
  --secret "id=secureboot_cert,src=${keys}/db.crt"
)
if ! "${as_root[@]}" podman image exists localhost/aegis-builder:latest; then
  echo "error: localhost/aegis-builder is missing; run scripts/build-builder first" >&2
  exit 1
fi

echo "== building the base root filesystem from ${base_image}"
"${as_root[@]}" podman build \
  --pull=missing \
  "${secrets[@]}" \
  --build-arg "BASE_IMAGE=${base_image}" \
  --build-arg "AEGIS_VERSION=${version}" \
  --build-arg "AEGIS_REVISION=${revision}" \
  --tag localhost/aegis-base-rootfs:latest \
  --file image/Containerfile \
  .

echo "== building the development root filesystem"
"${as_root[@]}" podman build \
  --build-arg "BASE=localhost/aegis-base-rootfs:latest" \
  --build-arg "AEGIS_VERSION=${version}" \
  --build-arg "AEGIS_REVISION=${revision}" \
  --tag localhost/aegis-dev-rootfs:latest \
  --file image/Containerfile.dev \
  .

# Each variant has its own root filesystem, so each gets its own digest and its own UKI.
for variant in base dev; do
  echo "== sealing localhost/aegis-${variant}"
  "${as_root[@]}" podman build \
    "${secrets[@]}" \
    --build-arg "ROOTFS=localhost/aegis-${variant}-rootfs:latest" \
    --tag "localhost/aegis-${variant}:latest" \
    --file image/Containerfile.seal \
    .
done

# The public halves, for the tests that enrol them in the virtual firmware.
mkdir -p out/secureboot
cp "${keys}"/{PK,KEK,db,untrusted}.crt "${keys}/owner-guid.txt" out/secureboot/

# B-01: both images must still be marked as bootable containers.
for image in localhost/aegis-base:latest localhost/aegis-dev:latest; do
  label="$("${as_root[@]}" podman image inspect \
    --format '{{ index .Labels "containers.bootc" }}' "${image}")"
  if [[ "${label}" != "1" ]]; then
    echo "error: ${image} lacks the label containers.bootc=1" >&2
    exit 1
  fi
  echo "ok: ${image} containers.bootc=1"
done

mkdir -p out
{
  echo "base_image=${base_image}"
  echo "revision=${revision}"
  echo "version=${version}"
  echo "podman=$(podman --version)"
  for image in localhost/aegis-base:latest localhost/aegis-dev:latest; do
    echo "${image}=$("${as_root[@]}" podman image inspect --format '{{ .Id }}' "${image}")"
  done
} > out/build-info.txt
cat out/build-info.txt
