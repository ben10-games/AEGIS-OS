policy_module(aegis, 1.0.0)

########################################
#
# AEGIS OS local policy for both image variants.
#
# This module contains no allow rule, no permissive domain and no dontaudit rule.
# It only assigns existing types to three paths (see aegis.fc) that bootc and bootupd
# create in the physical root at install time. Fedora's policy has no file-context
# rule for them, so they were labelled default_t, which bootupd_t may not read; every
# boot logged the resulting denials (BUG-1 in PROJECT_STATE.md).
#

gen_require(`
	type root_t;
	type boot_t;
')
